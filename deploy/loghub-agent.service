[Unit]
Description=LogHub host log collector
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/loghub-agent
Restart=always
RestartSec=5
Environment=LOGHUB_SERVER_URL=http://127.0.0.1:8080
Environment=RUST_LOG=info
# Optional: SYSTEMD_UNITS=docker.service,caddy.service,postgresql.service

[Install]
WantedBy=multi-user.target
