FROM rust:1.89-bookworm AS builder
WORKDIR /src
COPY . .
RUN cargo build --release -p loghub-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/loghub-server /usr/local/bin/loghub-server
EXPOSE 8080
CMD ["/usr/local/bin/loghub-server"]
